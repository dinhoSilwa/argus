{
  "name": "create-argus",
  "version": "0.1.2",
  "description": "Argus CLI — instala um sistema de engenharia completo em qualquer projeto",
  "type": "module",
  "bin": {
    "create-argus": "./dist/cli.js",
    "argus": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean",
    "dev": "tsup src/cli.ts --format esm --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0",
    "tar": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tar": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
